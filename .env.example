# =============================================================================
# Klaklork — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running `make install`.
# =============================================================================

# --- App ---
APP_NAME=Klaklork
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# --- Database (MySQL) ---
DB_DATABASE=klaklork
DB_USERNAME=klaklork
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password
DB_PORT_FORWARD=3307

# --- Port Mappings ---
APP_PORT=8000
FRONTEND_PORT=3000
REVERB_PORT=8080
PMA_PORT=8081

# --- Reverb / WebSocket ---
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- Frontend API URL ---
VITE_API_BASE_URL=http://localhost:8000/api
